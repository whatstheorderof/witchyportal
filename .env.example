# ─────────────────────────────────────────────────────────────────────
# Witchy Portal — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, set these per environment (Production / Preview / Development).
# ─────────────────────────────────────────────────────────────────────

# Postgres (Neon via Vercel Marketplace sets these automatically).
# DATABASE_URL: pooled connection used by the app.
# DATABASE_URL_UNPOOLED: direct connection used for migrations (optional).
DATABASE_URL=postgres://user:password@localhost:5432/witchy
DATABASE_URL_UNPOOLED=

# Signs admin session cookies. 32+ random characters, different per environment.
# Generate with:  openssl rand -base64 48
AUTH_SECRET=

# Canonical site URL (no trailing slash). Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Time zone used for scheduling posts and showing dates in admin.
NEXT_PUBLIC_SITE_TIMEZONE=Europe/London

# Vercel Blob read/write token (set automatically when you connect a Blob store).
# Leave empty locally to save uploads into public/uploads instead.
BLOB_READ_WRITE_TOKEN=

# Which payment link a booking option uses: "live" or "test".
# Default: live on Vercel Production, test everywhere else (previews, local).
PAYMENT_MODE=

# Extra hosts allowed in payment links, comma separated (Stripe, PayPal,
# Revolut, SumUp, Square, Wise and others are allowed by default).
PAYMENT_ALLOWED_HOSTS=

# Birth chart provider: "astronomy-engine" (default, real calculations)
# or "fixture" (clearly labelled fake data for interface work only).
BIRTH_CHART_PROVIDER=astronomy-engine

# Protects the daily YouTube import (Vercel Cron sends it automatically).
# Set in Production only:  openssl rand -hex 32
CRON_SECRET=

# Set to "1" to stop the app contacting YouTube (tests / offline development).
YOUTUBE_FETCH_DISABLED=

# Set to "true" to allow search engines outside Vercel Production.
ALLOW_INDEXING=

# Used only by `npm run admin:create` if you don't pass arguments.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
